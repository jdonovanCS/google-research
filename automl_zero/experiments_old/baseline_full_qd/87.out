  v7 = uniform(0.207942, 0.421532, n_features)
def Predict():
  s1 = s4 + s4
  v3 = dot(m0, v5)
  v4 = v3 + v5
  v1 = maximum(v5, v4)
  s1 = dot(v0, v6)
  v8 = v7 + v8
  s3 = dot(v3, v0)
  v7 = maximum(v3, v5)
  s2 = s0 + s0
def Learn():
  v6 = v8 + v3
  v4 = v0 * v2
  s1 = s1 - s0
  s3 = s0 - s1
  v7 = heaviside(v5, 1.0)
  v2 = v2 * v7
