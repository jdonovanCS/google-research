def Setup():
  s4 = uniform(0.0430867, 1.85417)
def Predict():
  v3 = dot(m1, v0)
  s2 = dot(v0, v7)
  v8 = maximum(v1, v0)
  v4 = v4 + v6
  v3 = dot(m1, v7)
  s1 = dot(v5, v0)
  v8 = dot(m1, v5)
def Learn():
  s2 = s0 - s3
  v1 = v5 + v2
  v3 = s0 * v1
  v4 = heaviside(v2, 1.0)
  s2 = s0 * s4
  s1 = s2 - s1
  v6 = s1 * v7
  m1 = m0 + m1
  s2 = s0 + s2
  s3 = s1 + s2
  v3 = s3 * v0
  v6 = s0 * v8
  m0 = m1 + m0
  m0 = outer(v1, v1)
  m0 = m0 + m0
  v5 = v5 + v3
  m1 = m1 + m1

