  s2 = gaussian(-0.849248, 0.32328)
  v8 = gaussian(-0.120819, 0.195216, n_features)
  v7 = uniform(-0.984883, -0.393854, n_features)
  v1 = gaussian(0.521574, 0.278038, n_features)
def Predict():
  v1 = maximum(v3, v0)
  s1 = dot(v0, v3)
  s1 = dot(v1, v7)
  v6 = dot(m1, v0)
  v1 = dot(m0, v4)
  v7 = v7 + v2
  v4 = dot(m1, v7)
  v2 = v8 + v5
def Learn():
  v4 = s0 * v8
  v2 = s0 * v0

