  v6 = gaussian(-0.329973, 0.552303, n_features)
  m1 = uniform(0.947087, -0.370246, (n_features, n_features))
  v1 = uniform(0.722523, 0.318185, n_features)
  s4 = uniform(0.840341, -0.701657)
def Predict():
  v2 = dot(m1, v6)
  v6 = maximum(v4, v4)
  s4 = dot(v8, v4)
  s4 = dot(v0, v1)
  s1 = dot(v0, v6)
  v3 = dot(m0, v2)
  v4 = v5 + v8
def Learn():
  v8 = s0 * v0
  v5 = v4 + v3
  v2 = v5 * v0
  m1 = outer(v3, v7)
  s3 = s2 - s2
  s2 = s1 * s0
  v7 = heaviside(v5, 1.0)
  v1 = heaviside(v8, 1.0)
  s1 = s1 + s0
  m0 = outer(v8, v8)
  s2 = s1 - s3
  m1 = m1 + m1
  s2 = s0 - s0
  s1 = s4 - s1

