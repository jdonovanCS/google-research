  s2 = dot(v1, v3)
  v1 = v2 + v2
  v7 = dot(m1, v1)
def Learn():
  s4 = s3 + s2
  s4 = s1 * s4
  v8 = heaviside(v5, 1.0)
  s2 = s0 * s1
