def Setup():
  m0 = uniform(0.683015, -0.864197, (n_features, n_features))
  s4 = gaussian(-0.161911, 0.301306)
  v2 = uniform(-0.496664, -0.131205, n_features)
  v1 = gaussian(0.926852, 0.12123, n_features)
  s2 = uniform(-1.13014, 0.382258)
  v6 = uniform(-0.629573, 0.768049, n_features)
def Predict():
  v2 = v2 + v5
  s1 = dot(v3, v0)
  v1 = v1 + v3
  v3 = v1 + v4
  v6 = maximum(v8, v1)
  s4 = dot(v4, v4)
  v7 = maximum(v0, v7)
def Learn():
  v3 = heaviside(v2, 1.0)
  s4 = s2 - s1
  m1 = m0 + m1
  v7 = v5 * v4
  v6 = v4 * v5
  s4 = s4 + s0
  v4 = s0 * v7
  m0 = outer(v4, v6)
  v6 = v6 + v2
  v3 = v2 + v2
  m1 = m0 + m1
  v7 = heaviside(v5, 1.0)
  v5 = s4 * v0
  m1 = outer(v2, v6)
  v8 = s0 * v8
  s3 = s0 - s1
  s1 = s1 + s4
  v8 = heaviside(v6, 1.0)
  m0 = outer(v8, v0)
  s4 = s2 + s0
  m1 = m1 + m0

