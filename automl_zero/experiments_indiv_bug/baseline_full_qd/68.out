def Setup():
  v6 = gaussian(-0.951339, 0.701383, n_features)
  m0 = uniform(-0.578834, -0.950086, (n_features, n_features))
  s4 = -0.594311
  s3 = uniform(-0.346849, 0.134706)
  v5 = gaussian(-0.196421, 0.533267, n_features)
  m1 = gaussian(0.397768, 0.694947, (n_features, n_features))
def Predict():
  v2 = v6 + v0
  v8 = dot(m0, v3)
  v7 = v5 + v6
  v3 = dot(m1, v5)
  s2 = s4 + s3
  s1 = dot(v7, v0)
  v6 = maximum(v6, v0)
def Learn():
  v5 = v7 + v4
  s3 = s2 - s1
  v3 = v3 + v6
  v6 = heaviside(v8, 1.0)
  v8 = s0 * v6
