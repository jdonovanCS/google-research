  s1 = dot(v0, v4)
  v1 = maximum(v7, v2)
  v3 = dot(m0, v7)
  v3 = v0 + v2
def Learn():
  m0 = outer(v7, v5)
  v3 = s0 * v3
  s1 = s0 - s1
  v4 = s4 * v7
  s3 = s0 + s0
  s1 = s2 + s1
  v1 = s0 * v4
