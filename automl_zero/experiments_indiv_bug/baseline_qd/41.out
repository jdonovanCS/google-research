  s3 = gaussian(-0.659061, 0.942779)
  s1 = uniform(-0.180156, -0.381057)
  m1 = gaussian(-0.519107, 0.575651, (n_features, n_features))
  s2 = 0.9745
def Predict():
  s2 = dot(v8, v5)
  v7 = v0 + v3
  v5 = dot(m1, v1)
  v3 = v3 + v4
  s1 = dot(v7, v0)
  v7 = dot(m0, v3)
  v2 = dot(m1, v2)
  v4 = maximum(v5, v8)
  s3 = dot(v3, v1)
  v2 = dot(m0, v5)
def Learn():
  m0 = outer(v2, v0)
  s3 = s1 * s3
  s2 = s4 + s4
  s1 = s4 - s1
  v7 = heaviside(v7, 1.0)
  v4 = s0 * v0
  v7 = heaviside(v1, 1.0)
  v5 = v3 + v1
  s3 = s3 * s1
  v1 = v0 * v0

