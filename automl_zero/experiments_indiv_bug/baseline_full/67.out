  v3 = s4 * v2
  v7 = v4 + v6
  m0 = outer(v7, v3)
  s4 = s2 * s2
  v4 = s2 * v4
  v1 = v3 + v7
  v8 = heaviside(v1, 1.0)
  v3 = v6 * v7
  v2 = s0 * v5
  v6 = heaviside(v5, 1.0)

