  v7 = uniform(0.247856, -0.961015, n_features)
  s4 = -1.34557
def Predict():
  v4 = v7 + v2
  s2 = s4 + s1
  s3 = dot(v8, v0)
  s4 = s3 + s4
  v3 = v6 + v7
  v2 = maximum(v2, v7)
  v5 = maximum(v7, v2)
  v4 = v0 + v6
  v1 = maximum(v4, v8)
  s1 = dot(v7, v0)
def Learn():
