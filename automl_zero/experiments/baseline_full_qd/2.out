def Setup():
  v4 = gaussian(-0.896537, 0.924838, n_features)
  s3 = uniform(0.202922, 2.58063)
  v8 = gaussian(-0.52011, 0.354418, n_features)
def Predict():
  v2 = v5 + v6
  s2 = dot(v6, v7)
  s4 = s4 + s1
  v1 = maximum(v2, v4)
  s2 = dot(v7, v1)
  s1 = dot(v5, v0)
def Learn():
  v5 = v3 + v2
  v1 = heaviside(v8, 1.0)
  v6 = s0 * v0
  s1 = s1 + s2
  m1 = m1 + m1
  m1 = outer(v7, v1)
  s2 = s3 - s1
  v3 = s2 * v6
  v4 = v0 + v1
  s4 = s1 + s1
  v2 = heaviside(v3, 1.0)

