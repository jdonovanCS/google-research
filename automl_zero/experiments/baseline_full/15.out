  s1 = uniform(-4.73755, 0.395331)
  v3 = uniform(-0.19509, 0.923988, n_features)
  v7 = uniform(0.00482184, 0.00979607, n_features)
def Predict():
  s1 = dot(v3, v0)
  v8 = maximum(v5, v1)
  s4 = s1 + s3
  v6 = maximum(v7, v6)
  s4 = s0 + s1
  s2 = s1 + s0
  s1 = s0 + s4
  s4 = dot(v7, v8)
  s2 = s4 + s1
  v3 = dot(m0, v7)
def Learn():
  v4 = v3 + v1
  s1 = s1 - s0
  v6 = v0 + v0
  m1 = outer(v1, v8)
  v3 = v7 * v1
  m0 = m1 + m0
  s4 = s0 - s1
  s4 = s4 - s2
  v5 = s4 * v6
  v1 = v1 + v5

