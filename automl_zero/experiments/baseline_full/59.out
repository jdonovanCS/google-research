  v3 = maximum(v5, v5)
  s2 = dot(v7, v2)
def Learn():
  s3 = s0 + s1
  v4 = v4 + v8
  m0 = m1 + m0
  m1 = m1 + m1
  s4 = s0 - s2
  s4 = s1 - s4
