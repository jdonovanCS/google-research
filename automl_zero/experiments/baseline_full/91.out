  s4 = s3 * s1
  v3 = v5 * v4
  s1 = s1 * s4
  v7 = v7 + v1
  m1 = outer(v3, v4)
  v5 = v1 * v2
  s3 = s2 * s3
  m1 = outer(v0, v6)

