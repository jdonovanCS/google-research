def Setup():
  v6 = uniform(-0.840473, 0.159844, n_features)
  m1 = uniform(-2.90858, -0.339039, (n_features, n_features))
  s2 = gaussian(0.469768, 0.143513)
  s4 = uniform(-0.593639, 0.836943)
  m0 = gaussian(0.106656, 0.345263, (n_features, n_features))
  s1 = -0.312253
def Predict():
  s1 = s2 + s0
  s1 = s4 + s3
  v8 = dot(m1, v4)
  s4 = s0 + s4
  s1 = s2 + s4
  v3 = maximum(v2, v6)
  v1 = dot(m0, v5)
  v7 = dot(m1, v7)
  s3 = s2 + s2
def Learn():
  s2 = s1 + s3
  v1 = heaviside(v0, 1.0)
  v4 = s2 * v4
  s3 = s3 + s2
  m1 = outer(v1, v0)
  m1 = outer(v1, v6)
  s2 = s4 + s4
  v1 = heaviside(v4, 1.0)
  v1 = v4 * v6
