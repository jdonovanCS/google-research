  s1 = s0 * s0
  v7 = heaviside(v0, 1.0)
  s4 = s3 - s1
  m1 = outer(v6, v6)
  v5 = heaviside(v0, 1.0)
  m0 = m0 + m1
  v7 = v7 + v0
  v2 = v2 * v7
  v4 = s0 * v0
  s1 = s3 - s0
  v1 = v1 + v4

