  m0 = m1 + m1
  s3 = s0 - s1
  v7 = v5 * v1
  v4 = s3 * v0
  v1 = v8 * v5
  v2 = v2 + v4
  v6 = v1 + v1
  v3 = v2 + v0
  v7 = s2 * v4

