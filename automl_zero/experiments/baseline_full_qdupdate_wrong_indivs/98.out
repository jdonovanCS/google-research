def Predict():
  s1 = dot(v0, v6)
  v2 = v2 + v3
  v3 = v1 + v3
  v6 = v8 + v8
  v1 = v3 + v7
  s2 = dot(v1, v0)
  s2 = dot(v4, v1)
def Learn():
  m1 = m0 + m1
  v6 = v1 + v0
  v2 = s1 * v8
  v2 = s0 * v0
  v4 = v5 + v8
  m1 = outer(v2, v6)
  m1 = outer(v5, v3)
  v8 = heaviside(v8, 1.0)
