def Setup():
  v3 = gaussian(0.450772, 0.55108, n_features)
  s4 = uniform(-0.79365, 0.689148)
  m0 = gaussian(0.674387, 1.29524, (n_features, n_features))
  v5 = uniform(-0.315701, 0.066447, n_features)
def Predict():
  v6 = maximum(v7, v1)
  s3 = dot(v6, v6)
  v2 = maximum(v8, v4)
  v5 = v5 + v7
  s3 = dot(v4, v1)
  s3 = dot(v7, v2)
  v8 = v8 + v7
  s1 = dot(v0, v3)
def Learn():
  v3 = v8 + v7
  v2 = v7 + v5
  v4 = s0 * v2
  v5 = v2 * v0
  m0 = outer(v4, v6)
  v1 = s0 * v0
  m0 = outer(v1, v7)
  v4 = heaviside(v5, 1.0)
  m0 = m0 + m0
  m0 = m1 + m1
  v8 = v6 + v4
